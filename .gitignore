.update_wanted_state

# Logs
*.log

# Backups
docker-compose.yml.bak
docker-compose.yml.avant-hardlinks
backup-fusion-4k-*/

# Python cache
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

