# =============================================================================
# MediaManager Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Paris

# User/Group IDs (run `id` to find yours)
PUID=1000
PGID=1000

# =============================================================================
# Storage Paths (absolute paths on host)
# =============================================================================
MEDIA_ROOT=/media/data
DOWNLOADS_DIR=/media/data/Downloads
MOVIES_DIR=/media/data/Movies
TV_DIR=/media/data/TV Shows
TRANSCODE_DIR=/media/backup/.transcode

# =============================================================================
# API Keys (generated by each service on first run)
# Find them in each service's web UI under Settings > General > API Key
# =============================================================================
RADARR_API_KEY=
RADARR_4K_API_KEY=
SONARR_API_KEY=
SONARR_4K_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
TAUTULLI_API_KEY=
OVERSEERR_API_KEY=

# =============================================================================
# Service URLs (for scripts - use localhost if running on same host)
# =============================================================================
RADARR_URL=http://localhost:7878
RADARR_4K_URL=http://localhost:7879
SONARR_URL=http://localhost:8989
SONARR_4K_URL=http://localhost:8990
TAUTULLI_URL=http://localhost:8181
OVERSEERR_URL=http://localhost:5055

# =============================================================================
# YGG Credentials (for Ygege indexer - optional)
# =============================================================================
YGG_USERNAME=
YGG_PASSWORD=

# =============================================================================
# TMDB API Token (for Ygege - get from https://www.themoviedb.org/settings/api)
# =============================================================================
TMDB_TOKEN=
